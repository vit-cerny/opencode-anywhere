# goto.env - where to find your opencode-anywhere slot.
# Copy this file to goto.env (right here in sync/), fill in the 3 values,
# and run:  bash sync/adopt.sh  (or  pwsh -File sync/adopt-windows.ps1)
#
# SAFE FILE: it only names your server and slot. Passwords, API keys, tokens,
# and SSH keys NEVER go here - connect authenticates with your existing SSH key.

# Your DuckDNS (or any) domain, e.g. the one you gave setup.sh.
DOMAIN=yourname.duckdns.org

# The slot name you were given (this becomes https://<slot>.<domain>).
SLOT=me

# Public IP of the opencode-anywhere VM (the Caddy/SSH host).
VM_IP=203.0.0.10

# OPTIONAL: a git repo you keep your opencode settings/extra-scripts in.
# Leave blank if you sync everything through the slot instead.
SETTINGS_REPO=